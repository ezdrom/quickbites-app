VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Demo mode: sample menu data when Supabase is unreachable AND auth guards bypassed (fake admin). Only honoured outside production builds (npm run dev); ignored by `vite build`. Keep false.
VITE_DEMO_MODE=false
# Public URL of the deployed web app (no trailing slash). Used for emailed links such as password reset, which would otherwise point at localhost inside the Android app.
VITE_APP_URL=
